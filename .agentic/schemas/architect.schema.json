{
  "$id": "agentic/architect",
  "type": "object",
  "required": ["architecture", "milestones", "backlog",
               "completion_criteria", "human_decisions"],
  "properties": {
    "architecture": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "title": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "milestone", "description", "dependencies",
                     "risk", "security_relevant", "expected_paths",
                     "expected_size", "acceptance_criteria",
                     "deterministic_checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "milestone": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "security_relevant": {"type": "boolean"},
          "expected_paths": {
            "type": "array",
            "description": "Required deliverables (the acceptance contract) -- NOT a second write allowlist; see allowed_paths for what may be touched. Either a legacy string (a literal path, a path ending '/' for a directory, or a glob for advisory matching) or an explicit object.",
            "items": {
              "type": ["string", "object"],
              "required": ["path"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "type": {"type": "string", "enum": ["file", "directory"]},
                "required": {"type": "boolean"},
                "non_empty": {"type": "boolean"}
              }
            }
          },
          "expected_size": {"type": "string",
                            "enum": ["small", "medium", "large"]},
          "acceptance_criteria": {"type": "array",
                                  "items": {"type": "string"}},
          "deterministic_checks": {"type": "array",
                                   "items": {"type": "string"}},
          "contract_amendment_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "allowed_kinds"],
            "properties": {
              "enabled": {"type": "boolean"},
              "allowed_kinds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["required_output", "allowed_path",
                           "deterministic_check", "acceptance_criterion"]
                }
              },
              "allowed_paths": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "allowed_commands": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "skill": {"type": ["string", "null"]},
          "kind": {"type": "string",
                   "description": "Optional: 'bootstrap' for scaffolding tasks with no test framework yet, 'test_setup' for the task that installs it. Unset for ordinary feature/business-logic tasks."}
        }
      }
    },
    "requirements_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "tasks"],
        "properties": {
          "requirement": {"type": "string"},
          "tasks": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "completion_criteria": {"type": "array", "items": {"type": "string"}},
    "human_decisions": {"type": "array", "items": {"type": "string"}}
  }
}
